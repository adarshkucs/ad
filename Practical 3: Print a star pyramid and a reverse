# Practical 3: Print a star pyramid and a reverse star pyramid
rows = int(input("Enter the number of rows: "))

print("Star pyramid:")
for i in range(1, rows + 1):
    print(" " * (rows - i) + "* " * i)

print("Reverse star pyramid:")
for i in range(rows, 0, -1):
    print(" " * (rows - i) + "* " * i)
